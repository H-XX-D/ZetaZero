{
  "name": "aide",
  "version": "1.1.0",
  "description": "AI Development Environment - A floating mini IDE that docks to your screen edge",
  "main": "main.js",
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "dev": "npm run dev:renderer",
    "build": "npm run build:renderer && electron-builder",
    "build:renderer": "node scripts/build-renderer.mjs",
    "dev:renderer": "node scripts/build-renderer.mjs --watch",
    "build:linux": "npm run build:renderer && electron-builder --linux",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build:win": "npm run build:renderer && electron-builder --win",
    "build:all": "npm run build:renderer && electron-builder -mwl"
  },
  "keywords": [
    "ai",
    "ide",
    "floating",
    "dock",
    "assistant",
    "editor",
    "terminal"
  ],
  "author": {
    "name": "ORKASTRATOR",
    "email": "todd@hendrixxdesign.com"
  },
  "homepage": "https://orkastrator.github.io/aide",
  "license": "GPL-2.0",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "monaco-editor": "^0.45.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.27.0",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.aide.app",
    "productName": "AIDE",
    "files": [
      "main.js",
      "index.html",
      "styles.css",
      "renderer.bundle.js",
      "license.js",
      "mascot.html",
      "voice-chat.html",
      "assets/**/*",
      "3d-print/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "assets/icon.png",
      "maintainer": "todd <todd@hendrixxdesign.com>"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "identity": "Todd Hendricks (3QR685K523)",
      "notarize": {
        "teamId": "3QR685K523"
      },
      "extendInfo": {
        "NSMicrophoneUsageDescription": "AIDE uses the microphone for voice commands like 'Hey Dee Dee' and 'Dee Dee hide'.",
        "NSDocumentsFolderUsageDescription": "AIDE needs access to your documents to open and save files.",
        "NSDesktopFolderUsageDescription": "AIDE needs access to your desktop to open and save files.",
        "NSDownloadsFolderUsageDescription": "AIDE needs access to downloads to open and save files.",
        "NSFileProviderDomainUsageDescription": "AIDE needs file access to work as an IDE."
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    }
  }
}
