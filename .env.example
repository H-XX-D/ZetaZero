# Z.E.T.A. Docker Compose environment example
#
# Copy to .env (or run ./quickstart.sh which generates .env + ./.zetazero/zeta.conf)
#
# Models: set these to full paths on YOUR machine
# ZETA_MODEL_MAIN_HOST=/home/you/models/qwen2.5-14b-instruct-q4_k_m.gguf
# ZETA_MODEL_SUB_HOST=/home/you/models/qwen2.5-coder-7b-instruct-q4_k_m.gguf
# ZETA_MODEL_EMBED_HOST=/home/you/models/nomic-embed-text-v1.5.f16.gguf
#
# Storage root on YOUR machine (will be mounted as /storage)
# ZETA_GITGRAPH_PATH=/home/you/.zetazero/storage
