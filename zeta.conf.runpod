# Runpod-specific overrides for Z.E.T.A.
# Mount this at /app/zeta.conf in the container.

ZETA_HOST="0.0.0.0"
ZETA_PORT="8080"

# Models (inside container - Runpod Network Volume mount)
MODEL_14B="/workspace/models/qwen2.5-14b-instruct-q4.gguf"
MODEL_7B_CODER="/workspace/models/qwen2.5-7b-coder-q4_k_m.gguf"
MODEL_EMBED="/workspace/models/qwen3-embedding-4b-q4_k_m.gguf"

# Storage (inside container)
ZETA_STORAGE="/workspace/zetazero"
ZETA_GKV_DIR="/workspace/zetazero/graph_kv"
ZETA_DREAM_DIR="/workspace/zetazero/dreams"
ZETA_LOG="/workspace/zetazero/logs/zeta.log"

# GPU / context defaults
GPU_LAYERS="999"
CTX_14B="4096"
CTX_7B="4096"
CTX_EMBED="512"
BATCH_SIZE="4096"
