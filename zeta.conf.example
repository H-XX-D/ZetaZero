# =============================================================================
# Z.E.T.A. Configuration File - EXAMPLE
# =============================================================================
# Copy this file to zeta.conf and customize for your setup.
#
# DOCKER: Mount your customized zeta.conf:
#   docker run -v ./zeta.conf:/app/zeta.conf:ro ghcr.io/h-xx-d/zetazero:latest
#
# NATIVE: Place in ./zeta.conf, ~/ZetaZero/zeta.conf, or /etc/zeta/zeta.conf
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
ZETA_HOST="0.0.0.0"
ZETA_PORT="8080"

# -----------------------------------------------------------------------------
# MODELS - Download from HuggingFace
# -----------------------------------------------------------------------------
# Docker mounts models to /models
# Native: change to your model directory

MODEL_14B="/models/qwen2.5-14b-instruct-q4_k_m.gguf"
MODEL_7B_CODER="/models/qwen2.5-coder-7b-instruct-q4_k_m.gguf"
MODEL_EMBED="/models/nomic-embed-text-v1.5.f16.gguf"

# -----------------------------------------------------------------------------
# GPU
# -----------------------------------------------------------------------------
GPU_LAYERS="999"    # 999=all GPU, 0=CPU only
CTX_14B="4096"
CTX_7B="2048"
CTX_EMBED="512"
BATCH_SIZE="2048"

# -----------------------------------------------------------------------------
# STORAGE
# -----------------------------------------------------------------------------
ZETA_STORAGE="/storage"

# Graph-KV cache directory (for prefill acceleration)
# Stores quantized attention states for fast concept retrieval
ZETA_GKV_DIR="/storage/graph_kv"

# Dream directory (for idle-time memory consolidation)
# Dreams are generated when system is idle, stored here for review
ZETA_DREAM_DIR="/storage/dreams"

# -----------------------------------------------------------------------------
# OPTIONAL: Index codebase on startup
# -----------------------------------------------------------------------------
# INDEX_PATH="/codebase"

# =============================================================================
# HARDWARE PRESETS - Uncomment for your GPU
# =============================================================================

# --- 12GB GPU (RTX 3060 12GB, 4070) ---
# MODEL_7B_CODER=""
# CTX_14B="2048"

# --- 8GB GPU (RTX 3060 8GB, 4060) ---
# MODEL_14B="/models/qwen2.5-7b-instruct-q4_k_m.gguf"
# MODEL_7B_CODER="/models/qwen2.5-coder-3b-instruct-q4_k_m.gguf"
# GPU_LAYERS="40"

# --- CPU Only ---
# GPU_LAYERS="0"
# MODEL_14B="/models/qwen2.5-7b-instruct-q4_k_m.gguf"
# CTX_14B="2048"

# =============================================================================
# CLOUD ROUTING (Optional - disabled by default)
# =============================================================================
# Enable smart routing to cloud APIs for complex tasks.
# If not configured, everything stays 100% local.
#
# How it works:
#   1. Z.E.T.A. evaluates query complexity
#   2. Simple queries → Local 14B (fast, free, private)
#   3. Complex queries → Cloud API with Z.E.T.A. context injected
#
# What ALWAYS stays local (even with cloud enabled):
#   - Memory/graph operations (privacy)
#   - Dreams (privacy)
#   - Embeddings (speed)

# CLOUD_ROUTING="false"              # Set "true" to enable
# CLOUD_COMPLEXITY_THRESHOLD="0.7"   # 0-1, higher = more stays local
# CLOUD_PROVIDER="openai"            # openai, anthropic, or both
# CLOUD_MODEL="gpt-4o"               # Model to use for complex queries

# API Keys (only needed if CLOUD_ROUTING="true")
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# =============================================================================
# OPENCODE INTEGRATION
# =============================================================================
# Z.E.T.A. exposes OpenAI-compatible endpoints for use with OpenCode, LiteLLM,
# and other OpenAI-compatible clients.
#
# Endpoints (enabled automatically):
#   POST /v1/chat/completions - Chat completions API
#   GET  /v1/models           - List available models
#
# To use with OpenCode:
#   1. Copy opencode.json.example to your project as opencode.json
#   2. Update the API URL to match ZETA_HOST:ZETA_PORT
#   3. Run: opencode -m zeta/zeta-cognitive
#
# Available models:
#   - zeta-cognitive (14B reasoning + memory graph)
#   - zeta-coder (7B code generation)
# =============================================================================

# =============================================================================
# SLURM GPU FARM (Optional - for HPC clusters)
# =============================================================================
# Deploy Z.E.T.A. across multiple GPU nodes using Slurm.
#
# Architecture:
#   Coordinator (head node) -> Load balances -> GPU Nodes (compute)
#                                    |
#                           Shared Storage (NFS/Lustre)
#
# Usage:
#   1. Build: g++ -std=c++17 -O2 -pthread scripts/slurm/coordinator.cpp -o coordinator
#   2. Start coordinator: ./coordinator --port 8000
#   3. Submit nodes: sbatch --array=0-3 scripts/slurm/zeta-array.sbatch
#   4. Point clients at coordinator: http://headnode:8000/v1

# ZETA_COORDINATOR=""                 # Coordinator URL (e.g., http://headnode:8000)
# ZETA_BASE_PORT="8080"               # Base port for array jobs (node N uses BASE+N)
# ZETA_SHARED_STORAGE=""              # Shared filesystem for graph (NFS/Lustre path)
# =============================================================================
